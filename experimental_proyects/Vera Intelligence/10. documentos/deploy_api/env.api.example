# Plantilla de variables de la API. Copiar a un archivo FUERA del repo (por ejemplo /etc/vera-intelligence/api.env, permisos 600)
# y completar. Nunca se versiona un archivo con valores reales. Los valores de abajo son marcadores.

# --- API ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"   (una por consumidor; varias separadas por coma)
VI_API_KEYS=REEMPLAZAR_CON_CLAVE_LARGA_DE_AL_MENOS_24_CARACTERES
VI_API_CLIENT=tigo_alto
# 0 = solo SQL (decidido 2026-10-16); 1 = enciende la búsqueda vectorial (las cualitativas tardan 2 a 4 min)
VI_API_VECTOR_SEARCH=0
VI_API_HOST=127.0.0.1
VI_API_PORT=8080
VI_API_MAX_CONCURRENT=3
VI_API_DAILY_LIMIT=200
VI_API_USER_DAILY_LIMIT=50
VI_API_USER_MAX_CONCURRENT=2
VI_API_MAX_QUEUE=20
VI_API_REQUIRE_USER=1
VI_API_WATCH_INTERVAL_S=300
VI_API_WARMUP=1
# Avisos a Slack (arranque, reinicio por Data Map nuevo, errores repetidos). Un webhook de entrada; vacío = sin avisos
# VI_API_ALERT_WEBHOOK=
# Dónde se guardan el registro de uso y el feedback (default: <proyecto>/.runtime/api)
# VI_API_DATA_DIR=
VI_API_JOB_TIMEOUT_S=420
# Solo si algún día el front llama desde el navegador (lo normal es NO: llama una función del lado servidor)
# VI_API_CORS_ORIGINS=https://mi-app.lovable.app

# --- Agente (las mismas que usa la app de Streamlit; host, base y usuario de Postgres ya están fijos en utils/postgres.py) ---
VERA_AI_API_KEY=
PGPASSWORD=
# Opcionales (definiciones de negocio desde Langfuse; sin ellas el agente usa los snapshots locales)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
